# Relay repository line-ending rules.
# Default: auto-detect and normalize to LF in the repository.
* text=auto eol=lf

# Fixtures and golden files must always use LF so byte-level assertions
# pass regardless of the developer's host OS (Windows CRLF checkout).
gateway-bp7-export/fixtures/** text eol=lf

# Kotlin, Python, YAML, and JSON are text; force LF.
*.kt text eol=lf
*.kts text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.xml text eol=lf
*.ps1 text eol=lf

# Binary assets: do not normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.apk binary
*.aab binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.tar.gz binary
*.keystore binary
*.jks binary
